# ── SMTP (use a SEPARATE domain for cold outreach, not apereel.com) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=john@getapereel.com
SMTP_PASS=your-app-password-here

# Sender identity
OUTREACH_FROM_NAME=John Lim
OUTREACH_FROM_EMAIL=john@getapereel.com
OUTREACH_REPLY_TO=john@apereel.com

# ── Hunter.io (optional — for verified email lookup) ──
HUNTER_API_KEY=

# ── Google Custom Search (optional — for company website lookup) ──
GOOGLE_CSE_KEY=
GOOGLE_CSE_ID=
